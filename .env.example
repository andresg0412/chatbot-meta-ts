# Fase 4: activar SOLO al usar las tres plantillas v2 de 48h/24h aprobadas en Meta.
# Conservan los índices C=0, X=1, N=2; Reprogramar se añade al final con R=3.
# El recordatorio de 2h conserva sus botones. Requiere RECORDATORIOS_PAYLOAD_ENABLED=true
# para enviar LEREC:<agenda_id>:R; sin payload, el flujo identifica la cita por documento.
RECORDATORIOS_REPROGRAMAR_ENABLED=false

# Lista de espera: oferta de cupo con un toque (D1/D1-bis/D10 de proyecto-ips/docs/features/
# 2026-10-07-lista-espera-aceptacion-y-escalamientos.md). Ambos apagados por defecto.
# OFERTA_PAYLOAD: la plantilla de oferta lleva el id de la oferta en el payload de sus 3 botones
#   (index 0 = A, 1 = R, 2 = G). "Sí, lo tomo" pide una confirmación de un toque en vez del documento.
#   Encender SOLO tras probar con un teléfono de LISTA_ESPERA_TELEFONOS_PILOTO que el id coincide con el botón tocado.
#   Si algo falla con el id, el bot pide el documento (nunca muestra un error).
# PREGUNTA_POST_RECHAZO: tras rechazar, pregunta si sigue en la lista ("Sí, seguir" / "No, gracias").
LISTA_ESPERA_OFERTA_PAYLOAD_ENABLED=false
LISTA_ESPERA_PREGUNTA_POST_RECHAZO=false

# D7: canal de la alerta del protocolo de crisis. 'whatsapp' (default): aviso de siempre a CANAL_ESCALAMIENTO_CRISIS.
# 'email': la alerta sale SOLO por correo, enviada por el backend (teléfono completo, sin el texto del paciente), y no se
# manda el WhatsApp. Requiere el backend de la Fase 3 con el correo configurado (EMAIL_PROVEEDOR, EMAIL_API_KEY,
# ALERTAS_RECEPCION_EMAIL_FROM, ALERTAS_RECEPCION_EMAIL_TO). El bloqueo del bot para ese número no cambia.
ALERTA_CRISIS_CANAL=whatsapp

# D12: recordatorios de la invitación a la lista de espera por ejecución (0 = no pedir; el backend decide a quién
# con LISTA_ESPERA_INVITACION_RECORDATORIO_HORAS, apagado por defecto).
LISTA_ESPERA_INVITACION_RECORDATORIO_LIMITE=50
