# Fase 4: activar SOLO al usar las tres plantillas v2 de 48h/24h aprobadas en Meta.
# Conservan los índices C=0, X=1, N=2; Reprogramar se añade al final con R=3.
# El recordatorio de 2h conserva sus botones. Requiere RECORDATORIOS_PAYLOAD_ENABLED=true
# para enviar LEREC:<agenda_id>:R; sin payload, el flujo identifica la cita por documento.
RECORDATORIOS_REPROGRAMAR_ENABLED=false

# Recordatorios sin pedir el documento (proyecto-ips/docs/features/2026-10-17-plantillas-sin-documento.md).
# PAYLOAD_ENABLED es el interruptor general. Cada ORDEN_* lista la acción de cada botón de esa plantilla, en orden:
#   C = Confirmo asistencia, X = Necesito cancelar, N = No podré asistir, R = Reprogramar, - = botón sin payload.
#   Los botones que sobran al final (p. ej. "Hablar con un agente") salen sin payload.
#   Vacía = esa plantilla sale sin payload y el paciente responde con su documento, como antes.
# Orden verificado en Meta (2026-10-26): 48h y 24h pendiente = C,X ; 24h confirmado = X. 2h: sin verificar, dejar vacía.
# Si Meta rechaza el envío por los parámetros, se reenvía una vez sin payload (queda el error en el log).
RECORDATORIOS_PAYLOAD_ENABLED=false
RECORDATORIOS_PAYLOAD_ORDEN_48H=
RECORDATORIOS_PAYLOAD_ORDEN_24H_PENDIENTE=
RECORDATORIOS_PAYLOAD_ORDEN_24H_CONFIRMADO=
RECORDATORIOS_PAYLOAD_ORDEN_2H=

# Lista de espera: oferta de cupo con un toque (D1/D1-bis/D10 de proyecto-ips/docs/features/
# 2026-10-07-lista-espera-aceptacion-y-escalamientos.md). Ambos apagados por defecto.
# OFERTA_PAYLOAD: la plantilla de oferta lleva el id de la oferta en el payload de sus 3 botones
#   (index 0 = A, 1 = R, 2 = G). "Sí, lo tomo" pide una confirmación de un toque en vez del documento.
#   Encender SOLO tras probar con un teléfono de LISTA_ESPERA_TELEFONOS_PILOTO que el id coincide con el botón tocado.
#   Si algo falla con el id, el bot pide el documento (nunca muestra un error).
# PREGUNTA_POST_RECHAZO: tras rechazar, pregunta si sigue en la lista ("Sí, seguir" / "No, gracias").
LISTA_ESPERA_OFERTA_PAYLOAD_ENABLED=false
LISTA_ESPERA_PREGUNTA_POST_RECHAZO=false

# D7: canal de la alerta del protocolo de crisis. 'whatsapp' (default): aviso de siempre a CANAL_ESCALAMIENTO_CRISIS.
# 'email': la alerta sale SOLO por correo, enviada por el backend (teléfono completo, sin el texto del paciente), y no se
# manda el WhatsApp. Requiere el backend de la Fase 3 con el correo configurado (EMAIL_PROVEEDOR, EMAIL_API_KEY,
# ALERTAS_RECEPCION_EMAIL_FROM, ALERTAS_RECEPCION_EMAIL_TO). El bloqueo del bot para ese número no cambia.
ALERTA_CRISIS_CANAL=whatsapp

# D12: recordatorios de la invitación a la lista de espera por ejecución (0 = no pedir; el backend decide a quién
# con LISTA_ESPERA_INVITACION_RECORDATORIO_HORAS, apagado por defecto).
LISTA_ESPERA_INVITACION_RECORDATORIO_LIMITE=50

# Cancelación automática de citas Pendiente de mañana (cron 13:10 -> /v1/campaigns/cancelacion-automatica).
# La bandera (CANCELACION_AUTOMATICA_ENABLED) vive en el BACKEND; aquí solo van el token y la pausa.
# TOKEN: el mismo valor de CANCELACION_AUTOMATICA_TOKEN del backend (header x-cancelacion-token). Vacío = el bot no llama al
# backend y la tarea responde 'no_iniciada'. Generarlo con: openssl rand -hex 24   (no escribir aquí el valor real)
# PAUSA_MS: espera entre una cita y la siguiente (default 500; 0 la desactiva).
CANCELACION_AUTOMATICA_TOKEN=
CANCELACION_AUTOMATICA_PAUSA_MS=500

# Avisos de cita cancelada al paciente (proyecto-ips/docs/features/2026-10-23-avisos-cancelacion-paciente.md).
# Los envía un poller con el mismo CANCELACION_AUTOMATICA_TOKEN (sin token no sale nada). Qué se avisa lo decide el BACKEND:
# CANCELACION_AUTOMATICA_AVISAR_PACIENTE (default true) y AVISO_CANCELACION_GLOBHO_ENABLED (default false).
# Nombres de las plantillas aprobadas en Meta (vacías = estos mismos valores).
NOMBRE_PLANTILLA_CITA_CANCELADA_SIN_CONFIRMACION=cita_cancelada_sin_confirmacion
NOMBRE_PLANTILLA_NOTIFICACION_CITA_CANCELADA=notificacion_cita_cancelada
# Cada cuánto se revisa la bandeja (default 60000, mínimo 10000).
AVISOS_CANCELACION_POLL_INTERVAL_MS=60000
